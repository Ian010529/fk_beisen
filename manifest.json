{
  "manifest_version": 3,
  "name": "北森题库识别助手",
  "version": "2.5.6",
  "description": "从本地题库识别北森测评题目、图形并高亮匹配选项",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://iflytek.ceping.com/*",
    "https://tas.talebase.com/*",
    "*://*.beisen.com/*",
    "*://*.bestalent.com/*",
    "*://*.beisencloud.com/*",
    "*://*.beisenc.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.beisen.com/*",
        "*://*.bestalent.com/*",
        "*://*.beisencloud.com/*",
        "*://*.beisenc.com/*",
        "https://iflytek.ceping.com/*",
        "https://tas.talebase.com/*"
      ],
      "js": ["platform-config.js", "psychometric-profile.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
